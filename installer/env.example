# ============================================================
#  Genius Scout - cles API (fichier optionnel)
#
#  Ce fichier est lu a chaque lancement de Genius Scout.
#  Colle tes cles apres le signe "=" puis relance l'application.
#  Sans cle, l'application fonctionne en mode degrade
#  (voir LISEZ-MOI.txt dans le dossier d'installation).
# ============================================================

# Cle API Anthropic (validation des comptes Instagram par Claude).
# A creer sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Spotify Web API (metadonnees d'album + tracklist).
# Cree une application sur https://developer.spotify.com/dashboard
# puis copie le Client ID et le Client Secret.
# Sans ces deux valeurs, l'extraction des credits Spotify est desactivee.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Jeton personnel Discogs (credits producteur / compositeur / ingenieur).
# A generer sur https://www.discogs.com/settings/developers (gratuit).
# Sans jeton : acces anonyme, plus lent et moins fiable.
DISCOGS_TOKEN=

# Mode de validation Instagram : budget | heuristic | llm
#   budget    = heuristique d'abord, Claude seulement si < 60 % trouves (recommande)
#   heuristic = jamais Claude (gratuit, moins precis)
#   llm       = Claude sur chaque candidat ambigu (le plus precis, plus couteux)
IG_VALIDATION_MODE=budget
